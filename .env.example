# Demo-client build-time configuration (all optional).
# Copy to `.env` (or `.env.local`) and adjust. None of these require a rebuild
# to retarget the demo at runtime — the API base URL is set in the browser
# (Settings page / first-run onboarding) and persisted to localStorage.

# Prefills the API base URL shown in the onboarding modal. When unset, the
# modal appears with a sensible localhost default. The user can still change
# it at runtime — the image stays origin-agnostic either way.
VITE_DEFAULT_API_URL=http://localhost:8000

# Override the Leaflet tile layer (defaults to OpenStreetMap). Respect the OSM
# tile usage policy if you keep the default: https://operations.osmfoundation.org/policies/tiles/
# VITE_MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png